[Unit]
Description=HYBRID_SNIPER sibling watchdog (emergency SL/TP closer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hybrid-sniper
ExecStart=/usr/bin/python3 -u watchdog.py
Restart=always
RestartSec=5
# Independent of main.py. Do not enable native TP/SL here.

[Install]
WantedBy=multi-user.target
