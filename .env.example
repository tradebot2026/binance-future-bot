# ==========================================================
# BINANCE FUTURES TRADING BOT — Environment Configuration
# ==========================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Python 3.11+ recommended (uses datetime.UTC).
# Start with USE_TESTNET=True until fully validated.
# ==========================================================

# ---------------- Binance API ----------------
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# True = Binance Futures Testnet | False = Live Mainnet
USE_TESTNET=True

# ---------------- Telegram (optional but recommended) ----------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ---------------- Trading ----------------
QUOTE_ASSET=USDT

# Multi-timeframe analysis
ENTRY_TIMEFRAME=5m
CONFIRM_TIMEFRAME=15m
TREND_TIMEFRAME=1h

# Main loop interval (seconds) — also used while entries are paused
SCAN_INTERVAL_SECONDS=15
MONITOR_INTERVAL_SECONDS=7
RECONCILIATION_INTERVAL_SECONDS=900

# Portfolio limits
MAX_OPEN_POSITIONS=12
MAX_LEVERAGE=25
AUTO_DETECT_MAX_LEVERAGE=True

# ---------------- Risk Management ----------------
RISK_PER_TRADE_PERCENT=2.0
DAILY_TARGET_PERCENT=20.0
DAILY_STOP_PERCENT=10.0
MAX_DAILY_TRADES=40
MAX_CONSECUTIVE_LOSSES=5
MAX_ACCOUNT_DRAWDOWN=20.0
MAX_POSITION_VALUE_MULTIPLIER=1.5

# Auto-restart on crash (0 = unlimited restarts)
RESTART_DELAY_SECONDS=10
MAX_RESTART_DELAY_SECONDS=120
MAX_AUTO_RESTARTS=0
ERROR_ALERT_THRESHOLD=3
CRITICAL_ALERT_COOLDOWN_SECONDS=300

# ---------------- API rate-limit protection ----------------
ENABLE_STRICT_RATE_LIMIT=True
API_BACKOFF_MAX_SECONDS=60
INIT_REST_DELAY_SECONDS=0.5
ENABLE_WEBSOCKET_STREAMS=True
WS_STALE_SECONDS=120
BOOK_TICKER_CACHE_SECONDS=90
RATE_LIMIT_HALT_SECONDS=300

# ---------------- Database maintenance ----------------
DB_RETENTION_DAYS=30
DB_MAINTENANCE_INTERVAL_SECONDS=86400

# ---------------- ATR Exit Levels ----------------
SL_ATR_MULTIPLIER=2.0
TP1_ATR_MULTIPLIER=1.5
TP2_ATR_MULTIPLIER=2.5
TP3_ATR_MULTIPLIER=4.0
ENABLE_BREAK_EVEN=True
ENABLE_TRAILING_STOP=True
ENABLE_PARTIAL_TP=True

# ---------------- Strategy / SMC ----------------
STRATEGY_MIN_SCORE=70.0
SCORE_FULL_SIZE=80.0
HALF_SIZE_MULTIPLIER=0.5
VOLUME_BONUS_POINTS=5.0
RETEST_LOOKBACK_BARS=12
RETEST_ZONE_ATR_TOLERANCE=0.35
MAX_CHASE_ATR=0.45
PD_LOOKBACK_BARS=48
ALLOW_NEUTRAL_MACRO_SETUPS=True
NEUTRAL_MACRO_MIN_SCORE=75.0
ALLOW_PD_EQUILIBRIUM=True
PD_EQUILIBRIUM_TOLERANCE_PCT=5.0
STRUCTURE_NEARBY_ATR_MULT=1.5

# ---------------- R:R & structural exits ----------------
SL_BUFFER_ATR=0.15
MAX_SL_ATR_MULTIPLIER=2.0
TP1_R_MULTIPLE=1.0
TP2_R_MULTIPLE=2.0
TP3_R_MULTIPLE=3.5
MIN_OPPOSING_RR=1.5
SYMBOL_COOLDOWN_MINUTES=20

# ---------------- Range regime ----------------
ENABLE_RANGE_REGIME=True
MAX_RANGE_POSITIONS=4
RANGE_COOLDOWN_MINUTES=5
RANGE_SIZE_MULTIPLIER=0.5
RANGE_DAILY_MAX_LOSS_PERCENT=3.0
RANGE_MAX_CONSECUTIVE_LOSSES=2
RANGE_REGIME_MAX_ADX_1H=22.0
RANGE_EXIT_ADX_15M=25.0
RANGE_BREAKOUT_ATR_MULT=0.3
RANGE_TIME_STOP_BARS=16
RANGE_EDGE_ATR_TOLERANCE=0.35
RANGE_LOOKBACK_BARS=48
RANGE_MIN_SCORE=65.0

# Legacy confidence tiers (optional scoring reference)
HIGH_CONFIDENCE_SCORE=90.0
MEDIUM_CONFIDENCE_SCORE=80.0
LOW_CONFIDENCE_SCORE=70.0

# ---------------- Market Filters ----------------
MIN_24H_VOLUME_USDT=15000000
MAX_SPREAD_PERCENT=0.15
WATCHLIST_SCORE=70.0
BLACKLIST_SCORE=40.0

# ---------------- Scanner / throughput tuning ----------------
MAX_WORKERS=1
SCAN_TIMEOUT_SEC=120
SCAN_PAIR_DELAY_SECONDS=0.25
SCAN_TIMEFRAME_DELAY_SECONDS=0.05
CANDLE_FETCH_LIMIT=280
MAX_SCAN_UNIVERSE=80
MAX_ENTRIES_PER_CYCLE=3
SCAN_WS_ONLY=True
BOOTSTRAP_KLINE_BATCH_SIZE=9
WS_KLINE_BUFFER_LIMIT=320
WS_USER_STALE_SECONDS=120
MULTI_CONFLUENCE_MIN_SCORE=65.0
NEAR_MISS_SCORE_MIN=65.0
NEAR_MISS_SCORE_MAX=69.0
NEAR_MISS_PRIORITY_MAX=25
DIRECTION_WIN_MARGIN=5.0
DIRECTION_EQUILIBRIUM_MIN_MARGIN=3.0
ENABLE_DIRECTION_EQUILIBRIUM_RESOLVE=True
SYMBOL_COOLDOWN_SOFT_MINUTES=5
RANGE_COOLDOWN_SOFT_MINUTES=2

# ---------------- Network / API Throttling ----------------
REQUEST_TIMEOUT=15
MAX_RETRIES=5
MIN_REQUEST_INTERVAL_MS=1000
BALANCE_CACHE_TTL_SECONDS=45
POSITION_CACHE_TTL_SECONDS=45
POSITION_CACHE_BACKOFF_SECONDS=60
MIN_NOTIONAL_RISK_TOLERANCE=1.35

# ---------------- Database ----------------
DATABASE_NAME=trading_bot.sqlite

# ---------------- Reports ----------------
ENABLE_DAILY_REPORT=True
ENABLE_WEEKLY_REPORT=True
ENABLE_MONTHLY_REPORT=True

# ---------------- Logging & Ops ----------------
LOG_LEVEL=INFO
TIMEZONE=UTC
HEARTBEAT_SECONDS=60
