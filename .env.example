# ==========================================================
# BINANCE FUTURES TRADING BOT — Environment Configuration
# ==========================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Python 3.11+ recommended (uses datetime.UTC).
# Start with USE_TESTNET=True until fully validated.
# ==========================================================

# ---------------- Binance API ----------------
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# True = Binance Futures Testnet | False = Live Mainnet
USE_TESTNET=True

# ---------------- Telegram (optional but recommended) ----------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ---------------- Trading ----------------
QUOTE_ASSET=USDT

# Multi-timeframe analysis
ENTRY_TIMEFRAME=5m
CONFIRM_TIMEFRAME=15m
TREND_TIMEFRAME=1h

# Main loop interval (seconds) — also used while entries are paused
SCAN_INTERVAL_SECONDS=15
MONITOR_INTERVAL_SECONDS=7
POSITION_GRACE_PERIOD_SECONDS=45
POSITION_RECONCILE_MISS_THRESHOLD=3
RECONCILIATION_INTERVAL_SECONDS=900

# Portfolio limits
MAX_OPEN_POSITIONS=12
MAX_LEVERAGE=25
AUTO_DETECT_MAX_LEVERAGE=True

# ---------------- Risk Management ----------------
RISK_PER_TRADE_PERCENT=2.0
DAILY_TARGET_PERCENT=20.0
DAILY_STOP_PERCENT=10.0
MAX_DAILY_TRADES=40
MAX_CONSECUTIVE_LOSSES=5
MAX_ACCOUNT_DRAWDOWN=20.0
MAX_POSITION_VALUE_MULTIPLIER=1.5

# Auto-restart on crash (0 = unlimited restarts)
RESTART_DELAY_SECONDS=10
MAX_RESTART_DELAY_SECONDS=120
MAX_AUTO_RESTARTS=0
ERROR_ALERT_THRESHOLD=3
CRITICAL_ALERT_COOLDOWN_SECONDS=300

# ---------------- API rate-limit protection ----------------
ENABLE_STRICT_RATE_LIMIT=True
API_BACKOFF_MAX_SECONDS=60
INIT_REST_DELAY_SECONDS=0.5
ENABLE_WEBSOCKET_STREAMS=True
WS_STALE_SECONDS=120
WS_STALE_SECONDS_TESTNET=60
WS_PING_INTERVAL_SECONDS=15
BOOK_TICKER_CACHE_SECONDS=90
RATE_LIMIT_HALT_SECONDS=300

# ---------------- Database maintenance ----------------
DB_RETENTION_DAYS=30
DB_MAINTENANCE_INTERVAL_SECONDS=86400

# ---------------- ATR Exit Levels ----------------
SL_ATR_MULTIPLIER=2.0
TP1_ATR_MULTIPLIER=1.5
TP2_ATR_MULTIPLIER=2.5
TP3_ATR_MULTIPLIER=4.0
ENABLE_BREAK_EVEN=True
ENABLE_TRAILING_STOP=True
ENABLE_PARTIAL_TP=True

# ---------------- Strategy / SMC ----------------
STRATEGY_MIN_SCORE=70.0
SCORE_FULL_SIZE=80.0
HALF_SIZE_MULTIPLIER=0.5
VOLUME_BONUS_POINTS=5.0
RETEST_LOOKBACK_BARS=12
RETEST_ZONE_ATR_TOLERANCE=0.35
MAX_CHASE_ATR=0.45
PD_LOOKBACK_BARS=48
ALLOW_NEUTRAL_MACRO_SETUPS=False
REQUIRE_BULLISH_MTF_FOR_LONG=True
REQUIRE_BEARISH_MTF_FOR_SHORT=True
ENABLE_MOMENTUM_CRASH_VETO=True
CRASH_VETO_DROP_PCT_5M=1.5
CRASH_VETO_DROP_PCT_15M=1.5
CRASH_BEARISH_BODY_ATR_MULT=1.75
NEUTRAL_MACRO_MIN_SCORE=75.0
ALLOW_PD_EQUILIBRIUM=True
PD_EQUILIBRIUM_TOLERANCE_PCT=5.0
STRUCTURE_NEARBY_ATR_MULT=1.5

# ---------------- R:R & structural exits ----------------
SL_BUFFER_ATR=0.15
MAX_SL_ATR_MULTIPLIER=2.0
TP1_R_MULTIPLE=1.0
TP2_R_MULTIPLE=2.0
TP3_R_MULTIPLE=3.5
MIN_OPPOSING_RR=1.5
SYMBOL_COOLDOWN_MINUTES=20

# ---------------- Range regime ----------------
ENABLE_RANGE_REGIME=True
MAX_RANGE_POSITIONS=4
RANGE_COOLDOWN_MINUTES=5
RANGE_SIZE_MULTIPLIER=0.5
RANGE_DAILY_MAX_LOSS_PERCENT=3.0
RANGE_MAX_CONSECUTIVE_LOSSES=2
RANGE_REGIME_MAX_ADX_1H=22.0
RANGE_EXIT_ADX_15M=25.0
RANGE_BREAKOUT_ATR_MULT=0.3
RANGE_TIME_STOP_BARS=16
RANGE_EDGE_ATR_TOLERANCE=0.35
RANGE_LOOKBACK_BARS=48
RANGE_MIN_SCORE=65.0

# Legacy confidence tiers (optional scoring reference)
HIGH_CONFIDENCE_SCORE=90.0
MEDIUM_CONFIDENCE_SCORE=80.0
LOW_CONFIDENCE_SCORE=70.0

# ---------------- Market Filters / Universe ----------------
MIN_24H_VOLUME_USDT=10000000
MAX_SPREAD_PERCENT=0.08
MIN_SCAN_UNIVERSE=50
MIN_24H_RANGE_PCT=0.75
MIN_UNIVERSE_ATR_PCT=0.08
UNIVERSE_ATR_LOOKBACK_BARS=20
ENABLE_UNIVERSE_ATR_FILTER=True
UNIVERSE_LOG_SYMBOL_PREVIEW=15
# Dynamic universe relaxation (Testnet / when strict filters yield too few symbols)
ENABLE_UNIVERSE_FILTER_RELAXATION=True
TESTNET_RELAX_UNIVERSE_FILTERS=True
TESTNET_MIN_24H_VOLUME_USDT=0
TESTNET_MIN_24H_RANGE_PCT=0
TESTNET_DISABLE_UNIVERSE_ATR_FILTER=True
RELAXED_MIN_24H_VOLUME_USDT=1000000
RELAXED_MIN_24H_RANGE_PCT=0.1
UNIVERSE_RELAXED_MIN_SYMBOLS=30
UNIVERSE_FALLBACK_TOP_N=50
ENABLE_WS_BOOK_STREAM=True
WATCHLIST_SCORE=70.0
BLACKLIST_SCORE=40.0

# ---------------- Scanner / throughput tuning ----------------
MAX_WORKERS=1
SCAN_TIMEOUT_SEC=120
SCAN_PAIR_DELAY_SECONDS=0.25
SCAN_TIMEFRAME_DELAY_SECONDS=0.05
CANDLE_FETCH_LIMIT=280
MAX_SCAN_UNIVERSE=80
MAX_ENTRIES_PER_CYCLE=3
SCAN_WS_ONLY=True
BOOTSTRAP_KLINE_BATCH_SIZE=9
WS_KLINE_BUFFER_LIMIT=320
WS_USER_STALE_SECONDS=120
MULTI_CONFLUENCE_MIN_SCORE=65.0
NEAR_MISS_SCORE_MIN=65.0
NEAR_MISS_SCORE_MAX=69.0
NEAR_MISS_PRIORITY_MAX=25
DIRECTION_WIN_MARGIN=5.0
DIRECTION_EQUILIBRIUM_MIN_MARGIN=3.0
ENABLE_DIRECTION_EQUILIBRIUM_RESOLVE=True
SYMBOL_COOLDOWN_SOFT_MINUTES=5
RANGE_COOLDOWN_SOFT_MINUTES=2

# ---------------- Network / API Throttling ----------------
REQUEST_TIMEOUT=15
MAX_RETRIES=5
MIN_REQUEST_INTERVAL_MS=1000
EXECUTION_MIN_REQUEST_INTERVAL_MS=200
BALANCE_CACHE_TTL_SECONDS=600
BALANCE_REST_POLL_SECONDS=600
ACCOUNT_REST_MIN_INTERVAL_SECONDS=300
IP_BAN_HALT_SECONDS=600
REST_BUDGET_ACCOUNT_RESERVE_FRACTION=0.15
POSITION_CACHE_TTL_SECONDS=300
POSITION_CACHE_BACKOFF_SECONDS=600
REST_TOKEN_BUCKET_CAPACITY=50
REST_TOKEN_REFILL_PER_SECOND=0.8
REST_BAN_MIN_SLEEP_SECONDS=600
REST_BLOCK_LOG_INTERVAL_SECONDS=600
REST_NETWORK_MAX_RETRIES=1
ENABLE_REST_KLINE_BOOTSTRAP=False
ENABLE_WS_KLINE_STARTUP_BOOTSTRAP=True
ENABLE_PACED_KLINE_BOOTSTRAP=True
WS_KLINE_BOOTSTRAP_MIN_BARS=250
WS_KLINE_BOOTSTRAP_CONCURRENCY=1
WS_KLINE_BOOTSTRAP_REQUEST_TIMEOUT_SECONDS=3
WS_KLINE_BOOTSTRAP_OVERALL_TIMEOUT_SECONDS=90
WS_KLINE_BOOTSTRAP_REST_DELAY_SECONDS=0.3
WS_KLINE_MAX_STREAMS_PER_SOCKET=100
WS_KLINE_LIVE_TIMEFRAMES_ONLY=True
WS_KLINE_SOCKET_STALE_SECONDS=600
ENABLE_EVENT_DRIVEN_SCAN=True
SCAN_TRIGGER_TIMEFRAMES=5m,15m
TIER1_WATCHLIST_SIZE=100
HOT_SCAN_SIZE=15
HOT_SCAN_INTERVAL_SECONDS=20
BACKGROUND_SCAN_BATCH_SIZE=8
BACKGROUND_SCAN_BATCH_DELAY_SECONDS=1
TIER2_HOT_SIZE=20
# Legacy absolute gates (unused by normalized Tier-2 logic; kept for compatibility)
TIER2_PROMOTE_SCORE=80
TIER2_DEMOTE_SCORE=70
# Normalized Tier-2 gates: (raw-min)/(100-min)*100 — fair across strategies
TIER2_PROMOTE_NORMALIZED=70
TIER2_DEMOTE_NORMALIZED=50
EVENT_EVAL_STAGGER_MS=50
EVENT_CATCHUP_INTERVAL_SECONDS=60
REST_BUDGET_WEIGHT_PER_MINUTE=200
REST_BUDGET_MIN_REMAINING_FRACTION=0.20
ENABLE_REST_TICKER_FALLBACK=True
ENABLE_REST_BALANCE_POLL=False
ENABLE_REST_POSITION_POLL=False
ENABLE_REST_PRICE_FALLBACK=False
BACKGROUND_WS_ONLY=True
DEFER_REST_UNTIL_WS_READY=True
USE_WS_BOOK_PROXY=True
WS_WARMUP_SECONDS=120
WS_STARTUP_WAIT_SECONDS=45
TICKER_REST_FALLBACK_AFTER_SECONDS=10
TICKER_REST_MIN_INTERVAL_SECONDS=30
WS_RECONNECT_JOIN_TIMEOUT_SECONDS=2
WS_SHUTDOWN_JOIN_TIMEOUT_SECONDS=10
STARTUP_TICKER_REST_SEED=True
STARTUP_BALANCE_MAX_ATTEMPTS=5
STARTUP_BALANCE_RETRY_SECONDS=3
WS_RECONNECT_ENABLED=True
WS_RECONNECT_MIN_SECONDS=5
WS_RECONNECT_MAX_SECONDS=30
WS_RECONNECT_LOG_INTERVAL_SECONDS=60
WS_HEALTH_CHECK_SECONDS=30
WS_RECONNECT_DEBOUNCE_SECONDS=5
POSITION_CACHE_TTL_SECONDS=45
POSITION_CACHE_BACKOFF_SECONDS=60
MIN_NOTIONAL_RISK_TOLERANCE=1.35

# ---------------- Multi-strategy modular pipeline ----------------
ENABLE_STRATEGY_SMC=True
ENABLE_STRATEGY_RANGE=True
ENABLE_STRATEGY_LIQUIDITY_SWEEP=True
ENABLE_STRATEGY_VWAP_PULLBACK=True
ENABLE_STRATEGY_VP_BREAKOUT=True
ENABLE_STRATEGY_VOL_EXPANSION=True
ALLOW_CROSS_STRATEGY_SCALE_IN=False
ENABLE_PORTFOLIO_ALLOCATOR=True
ENABLE_GLOBAL_STRATEGY_KILL_SWITCH=True
USE_UNIFIED_SCAN_PIPELINE=False
VP_BREAKOUT_TOP_VOLUME_LIMIT=20
VWAP_SESSION_ANCHOR_UTC=True
MAX_SMC_POSITIONS=8
STRATEGY_PRIORITY_SMC=1.0
STRATEGY_PRIORITY_RANGE=0.8
STRATEGY_BUDGET_SMC=0.35
STRATEGY_BUDGET_RANGE=0.10
MAX_ACCOUNT_MARGIN_UTILIZATION=0.65
MIN_LIQUIDATION_BUFFER_PCT=25.0
MAX_GROSS_EXPOSURE_PCT=2.5
MAX_NET_LONG_EXPOSURE_PCT=1.5
MAX_NET_SHORT_EXPOSURE_PCT=1.5
SMC_DAILY_MAX_LOSS_PERCENT=5.0
SMC_MAX_CONSECUTIVE_LOSSES=3

# ---------------- Database ----------------
DATABASE_NAME=trading_bot.sqlite

# ---------------- Reports ----------------
ENABLE_DAILY_REPORT=True
ENABLE_WEEKLY_REPORT=True
ENABLE_MONTHLY_REPORT=True

# ---------------- Logging & Ops ----------------
LOG_LEVEL=INFO
TIMEZONE=UTC
HEARTBEAT_SECONDS=60
